# Copy to .env.local (never commit real values).
#
# The dashboard itself needs NO environment variables: the Airtable token, Base ID and
# Table ID are typed into the dashboard's "חיבור ל-Airtable" panel in the browser.

# Only for scripts/apify-trial.mjs (run locally), never used by the dashboard
APIFY_TOKEN=

# --- The automatic run (GitHub Actions secrets with the same names; here only for local runs) ---
# Personal access token with read + write on the My New Job base (separate from the dashboard's token)
AIRTABLE_TOKEN=
# Optional: without it jobs are stored without a match score
ANTHROPIC_API_KEY=
# Optional: model used for scoring (default claude-sonnet-5-5)
MATCH_MODEL=
