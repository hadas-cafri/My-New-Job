# Copy to .env.local (never commit real values)

# Random string, 16+ chars. Encrypts the Airtable token stored in the cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Airtable base (not a secret)
AIRTABLE_BASE_ID=appAnHmtOjUfgQAcA

# Only for scripts/apify-trial.mjs (local / CI), never exposed to the dashboard
APIFY_TOKEN=
